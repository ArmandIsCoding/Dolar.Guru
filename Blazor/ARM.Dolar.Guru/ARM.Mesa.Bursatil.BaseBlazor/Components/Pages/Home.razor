@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using ARM.Mesa.Bursatil.Models
@using ARM.Mesa.Bursatil.Services
@using ARM.Mesa.Bursatil.BaseBlazor.Models
@using System.Globalization
@inject CotizacionesService Quotes
@inject NewsService News
@inject ILogger<Home> Logger
<PageTitle>Mesa Bursátil · Tu terminal de mercado</PageTitle>

<div class="market-tape @(paused ? "paused" : "")">
    <div class="tape-label"><span class="status-dot"></span> MARKET WATCH <button @onclick="() => paused = !paused" aria-label="@(paused ? "Reanudar marquesina" : "Pausar marquesina")">@(paused ? "▶" : "Ⅱ")</button></div>
    <div class="tape-window">
        @if (dollars.Count > 0)
        {
            <div class="tape-track">
                @for (var copy = 0; copy < 2; copy++)
                {
                    <div class="tape-group" aria-hidden="@(copy == 1 ? "true" : "false")">
                        @foreach (var quote in dollars)
                        {
                            <span class="tape-item"><strong>USD / @DisplayName(quote.Nombre).ToUpperInvariant()</strong><span>@MarketFormat.Money(quote.Venta)</span><small>VENTA</small></span>
                        }
                    </div>
                }
            </div>
        }
        else { <span class="tape-placeholder">DÓLARES · ÍNDICES · COMMODITIES · FUTUROS</span> }
    </div>
</div>

<div class="shell terminal">
    <section class="world-strip" aria-label="Resumen de índices y commodities">
        @foreach (var symbol in StripSymbols)
        {
            var index = indices.FirstOrDefault(x => x.Symbol == symbol);
            <a class="world-tile" href="#mercados" title="@(index is null ? "Pendiente de sincronización" : $"Rava · {GlobalMarkets.SourceDate(index)} · {GlobalMarkets.Unit(symbol)}")">
                <span class="world-label">@GlobalMarkets.Name(symbol)<span>↗</span></span>
                <div class="world-price">@(index?.Last.ToString("N2", MarketFormat.Culture) ?? "—") <span class="@GlobalMarkets.Tone(index?.Change)">@GlobalMarkets.Change(index?.Change)</span></div>
                <div class="world-bottom"><span>@(index is null ? "SIN DATOS" : GlobalMarkets.SourceDate(index))</span><span class="world-spark @(index is null ? "" : GlobalMarkets.HistoryTone(index))">@if (index is not null) { <Sparkline Values="index.HistoryValues" Label="@($"Histórico 30 días: {symbol}")" /> }</span></div>
            </a>
        }
    </section>

    <header class="desk-heading">
        <div><div class="eyebrow"><span class="tiny-cross">+</span> ARGENTINA / PANEL GENERAL</div><h1>El mercado. <span>Ahora.</span></h1></div>
        <div class="desk-update"><span class="update-caption"><span class="status-dot @(Stale ? "stale" : "")"></span> @(latest == DateTime.MinValue ? "Esperando cotizaciones" : $"Dólar: {MarketFormat.Date(latest)}")</span><button class="outline-button" @onclick="Refresh" disabled="@busy">@(busy ? "Actualizando…" : "↻ Actualizar")</button></div>
    </header>
    @if (error is not null) { <div class="notice" role="alert">@error</div> }

    <div class="desk-grid">
        <div class="desk-main">
            <section id="cotizaciones">
                <div class="market-toolbar">
                    <div class="segmented" aria-label="Tipo de cotizaciones">
                        <button class="@(category == "dolar" ? "selected" : "")" aria-pressed="@(category == "dolar")" @onclick='() => category = "dolar"'>Dólares <small>@dollars.Count</small></button>
                        <button class="@(category == "divisas" ? "selected" : "")" aria-pressed="@(category == "divisas")" @onclick='() => category = "divisas"'>Divisas <small>@others.Count(x => x.Moneda != "USD")</small></button>
                    </div>
                    <select class="order-select" aria-label="Ordenar cotizaciones" @bind="order"><option value="default">Orden: principales</option><option value="price">Mayor venta</option><option value="name">Nombre A–Z</option></select>
                </div>
                @if (busy && dollars.Count == 0) { <div class="empty-state" role="status">Consultando las cotizaciones…</div> }
                else if (category == "dolar")
                {
                    <div class="quote-grid">
                        @foreach (var q in OrderedDollars)
                        {
                            var gap = Gap(q.Nombre);
                            var chart = Series(q.Nombre);
                            <article class="quote-card @(q.Nombre == "Blue" ? "featured" : "")">
                                <div class="quote-top"><div class="quote-name"><span class="instrument-code">@Code(q.Nombre)</span><h2>Dólar @DisplayName(q.Nombre)</h2></div><span class="quote-currency">USD</span></div>
                                <div class="quote-sell"><span>VENTA</span><strong>@MarketFormat.Money(q.Venta)</strong></div>
                                <div class="quote-buy"><span>COMPRA</span><strong>@MarketFormat.Money(q.Compra)</strong></div>
                                <div class="quote-insight">
                                    <span class="gap-label">@(q.Nombre == "Oficial" ? "TIPO DE CAMBIO BASE" : gap.HasValue ? $"BRECHA {gap.Value.ToString("+0.0;-0.0;0.0", MarketFormat.Culture)}%" : "SIN REFERENCIA OFICIAL")</span>
                                    @if (chart.Count > 1) { <span class="quote-spark @GlobalMarkets.Tone(chart[^1].Venta - chart[0].Venta)"><Sparkline Values="chart.Select(x => x.Venta).ToArray()" Label="@($"Precio de venta, últimos {chart.Count} registros de {q.Nombre}")" /></span> }
                                    else { <span class="history-pending" title="La curva aparecerá con más de un registro">HIST. —</span> }
                                </div>
                                <div class="quote-bottom"><time>@MarketFormat.Date(q.FechaActualizacion)</time><a href="#conversor" @onclick="() => selected = q.Nombre" aria-label="@($"Convertir con dólar {DisplayName(q.Nombre)}")">Calcular ↗</a></div>
                            </article>
                        }
                        <a class="futures-callout" href="/proyecciones">
                            <div class="eyebrow">LA PRÓXIMA JUGADA <span>↗</span></div><h2>Dólar<br />futuro.</h2>
                            @if (nearestFuture is not null) { <div class="future-quote"><span>@nearestFuture.Especie</span><strong>@FuturePrice(nearestFuture.Ultimo)</strong></div> }
                            else { <p>Contratos, vencimientos<br />y perspectiva de mercado.</p> }
                            <span class="callout-link">Explorar contratos <span>→</span></span>
                        </a>
                    </div>
                    @if (dollars.Count == 0 && !busy) { <div class="empty-state"><strong>El panel está listo para su primera rueda.</strong><p>Las cotizaciones aparecerán después de la sincronización.</p></div> }
                }
                else
                {
                    <div class="quote-grid">
                        @foreach (var q in OrderedOthers)
                        {
                            <article class="quote-card">
                                <div class="quote-top"><div class="quote-name"><span class="instrument-code">@q.Moneda</span><h2>@q.Nombre</h2></div><span class="quote-currency">ARS</span></div>
                                <div class="quote-sell"><span>VENTA</span><strong>@MarketFormat.Money(q.Venta)</strong></div><div class="quote-buy"><span>COMPRA</span><strong>@MarketFormat.Money(q.Compra)</strong></div>
                                <div class="quote-insight"><span class="gap-label">1 @q.Moneda EN PESOS ARGENTINOS</span></div>
                                <div class="quote-bottom"><time>@MarketFormat.Date(q.FechaActualizacion)</time></div>
                            </article>
                        }
                    </div>
                    @if (!OrderedOthers.Any()) { <div class="empty-state">Todavía no hay divisas sincronizadas.</div> }
                }
                <div class="source-note"><span>↳ DolarAPI · valores en ARS</span><span>Brechas sobre venta oficial · curvas de venta, hasta 50 registros</span></div>
                @if (Stale) { <p class="freshness-note"><span class="status-dot stale"></span> Últimos valores disponibles: más de 2 h sin actualización de la fuente.</p> }
            </section>

            <section class="spread-board" aria-label="Brechas cambiarias">
                <div><span class="eyebrow">ENTRE DÓLARES</span><h2>La brecha,<br />a la vista.</h2></div>
                @foreach (var name in new[] { "Blue", "Bolsa", "Contado con liquidación" })
                {
                    <div class="spread-item"><span>@DisplayName(name).ToUpperInvariant() / OFICIAL</span><strong>@(Gap(name)?.ToString("N1", MarketFormat.Culture) ?? "—")<small>%</small></strong></div>
                }
            </section>
        </div>

        <aside class="desk-sidebar">
            <ExchangeConverter Quotes="dollars" @bind-Instrument="selected" />
            <section class="sidebar-brief"><div class="eyebrow">LECTURA RÁPIDA <span>↗</span></div><h2>¿Cuánto son<br />100 dólares?</h2><div><span>Al blue · venta</span><strong>@(dollars.FirstOrDefault(x => x.Nombre == "Blue") is Cotizacion blue ? MarketFormat.Money(100 * blue.Venta) : "—")</strong></div><p>Una referencia simple, antes de hacer tus números.</p></section>
        </aside>
    </div>

    <GlobalMarkets Indices="indices" />

    <section class="analysis-grid" id="historico">
        <div class="panel history-panel"><MarketHistory /></div>
        <div class="perspective-card"><div class="eyebrow">LA VENTAJA ES ENTENDER</div><h2>Un dato es un número.<br /><em>El contexto lo cambia todo.</em></h2><p>Conectá la cotización de hoy con su recorrido. Explorá los registros y los contratos que marcan las expectativas del mercado.</p><a href="/proyecciones" class="primary-button">Abrir análisis de mercado <span>↗</span></a><span class="perspective-watermark" aria-hidden="true">↗</span></div>
    </section>

    <section class="news-section">
        <div class="section-heading"><div><span class="eyebrow">LO QUE HAY DETRÁS DEL PRECIO</span><h2>En el radar<span class="accent">.</span></h2></div><a class="text-link" href="/news">Toda la actualidad ↗</a></div>
        <div class="news-grid">
            @for (var i = 0; i < news.Count; i++)
            {
                var item = news[i];
                <article class="news-card"><div class="news-visual visual-@i" aria-hidden="true"><span class="news-art-label">MB / MARKET INTELLIGENCE</span><span class="news-art-title">@(i == 0 ? "ECONOMÍA" : i == 1 ? "ARGENTINA" : "PERSPECTIVA")</span><span class="news-art-number">0@(i + 1)</span><span class="news-art-arrow">↗</span></div><div class="news-body"><div class="news-category"><span>@item.Fuente</span><time>@MarketFormat.Date(item.FechaPublicacion)</time></div><h3><a href="@MarketFormat.SafeUrl(item.Url)" target="_blank" rel="noopener noreferrer">@item.Titulo</a></h3><a class="news-read" href="@MarketFormat.SafeUrl(item.Url)" target="_blank" rel="noopener noreferrer">Leer en el medio <span>↗</span></a></div></article>
            }
        </div>
        @if (news.Count == 0) { <div class="empty-state">Las próximas noticias aparecerán con la sincronización.</div> }
    </section>
    <div class="terminal-footnote"><span class="status-dot"></span><span>El panel lee la base cada 60 s. Las fuentes pueden tener demoras. Horarios del dólar en Argentina; índices según la fuente.</span><a href="/ingesta">Fuentes y metodología ↗</a></div>
</div>

@code {
    private static readonly string[] StripSymbols = ["MERVAL", "NASDAQ 100", "S&P 500", "RIESGO PAIS", "ORO (F)", "PETROLEO WTI (F)"];
    private static readonly string[] DollarOrder = ["Blue", "Oficial", "Bolsa", "Contado con liquidación", "Cripto", "Tarjeta", "Mayorista"];
    private List<Cotizacion> dollars = [];
    private List<CotizacionOtros> others = [];
    private List<MarketIndex> indices = [];
    private List<NewsItem> news = [];
    private Dictionary<string, List<(DateTime Fecha, decimal Venta)>> history = [];
    private FuturoRavaRofex? nearestFuture;
    private bool busy, paused;
    private string category = "dolar", selected = "", order = "default";
    private string? error;
    private DateTime latest;
    private bool Stale => latest != DateTime.MinValue && DateTime.UtcNow - latest > TimeSpan.FromHours(2);
    private readonly CancellationTokenSource stop = new();
    private Task? polling;
    private IEnumerable<Cotizacion> OrderedDollars => order switch {
        "price" => dollars.OrderByDescending(x => x.Venta), "name" => dollars.OrderBy(x => DisplayName(x.Nombre)),
        _ => dollars.OrderBy(x => Array.IndexOf(DollarOrder, x.Nombre) is var rank && rank >= 0 ? rank : 99)
    };
    private IEnumerable<CotizacionOtros> OrderedOthers => order switch {
        "price" => others.Where(x => x.Moneda != "USD").OrderByDescending(x => x.Venta),
        _ => others.Where(x => x.Moneda != "USD").OrderBy(x => x.Nombre)
    };
    private decimal? Gap(string name) {
        var official = dollars.FirstOrDefault(x => x.Nombre == "Oficial");
        var quote = dollars.FirstOrDefault(x => x.Nombre == name);
        return official?.Venta > 0 && quote is not null ? (quote.Venta / official.Venta - 1) * 100 : null;
    }
    private List<(DateTime Fecha, decimal Venta)> Series(string name) => history.GetValueOrDefault(name) ?? [];
    private static string DisplayName(string name) => name switch { "Bolsa" => "MEP", "Contado con liquidación" => "CCL", _ => name };
    private static string Code(string name) => name switch { "Blue" => "BLU", "Oficial" => "BNA", "Bolsa" => "MEP", "Contado con liquidación" => "CCL", "Cripto" => "USDT", "Tarjeta" => "TRJ", "Mayorista" => "MAY", _ => "USD" };
    private static string FuturePrice(string raw) => decimal.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out var value) ? MarketFormat.Money(value) : "—";
    protected override Task OnInitializedAsync() => Refresh();
    protected override Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) polling = Poll();
        return Task.CompletedTask;
    }
    private async Task Refresh() {
        if (busy) return;
        busy = true;
        try {
            (dollars, others) = await Quotes.ObtenerUltimasCotizacionesAsync();
            news = (await News.ObtenerUltimasNoticiasAsync(100))
                .Where(item => Uri.TryCreate(item.Url, UriKind.Absolute, out var uri)
                    && uri.AbsolutePath.Split('/').Any(segment => segment.Equals("economia", StringComparison.OrdinalIgnoreCase)))
                .Take(3).ToList();
            indices = await Quotes.ObtenerIndicesAsync();
            history = await Quotes.ObtenerSeriesVentaAsync();
            nearestFuture = (await Quotes.ObtenerUltimosFuturosRavaAsync()).FirstOrDefault(x =>
                x.Especie.StartsWith("DLR/") && DateTime.TryParse(x.Vencimiento, CultureInfo.InvariantCulture, DateTimeStyles.AdjustToUniversal, out var expiry) && expiry.Date >= DateTime.UtcNow.Date);
            latest = dollars.Select(x => x.FechaActualizacion).DefaultIfEmpty(DateTime.MinValue).Max();
            error = null;
        } catch (Exception ex) {
            Logger.LogError(ex, "No se pudo consultar el panel");
            error = "No pudimos actualizar todos los datos. Conservamos los últimos valores disponibles; podés volver a intentar.";
        } finally { busy = false; }
    }
    private async Task Poll() {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try {
            while (await timer.WaitForNextTickAsync(stop.Token))
                await InvokeAsync(async () => { await Refresh(); StateHasChanged(); });
        } catch (OperationCanceledException) when (stop.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync() {
        await stop.CancelAsync();
        if (polling is not null) await polling;
        stop.Dispose();
    }
}
