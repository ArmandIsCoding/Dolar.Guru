@using System.Globalization
@using ARM.Mesa.Bursatil.Models
@using ARM.Mesa.Bursatil.Services
@using ARM.Mesa.Bursatil.BaseBlazor.Models
@inject CotizacionesService Quotes
<div class="stack">
    <section class="panel"><MarketHistory /></section>
    <section class="panel">
        <div class="eyebrow">MERCADO DE FUTUROS / RAVA</div><div class="section-heading compact"><h2>La curva de expectativas.</h2><span class="muted">Últimos contratos disponibles</span></div>
        @if (futures.Count == 0) { <div class="empty-state">Todavía no hay contratos de futuros disponibles. El resto del panel sigue funcionando.</div> }
        else {
            <FuturesCurve />
            <div class="table-scroll"><table class="market-table"><thead><tr><th>Contrato</th><th>Vencimiento</th><th>Último</th><th>Variación</th><th>Compra</th><th>Venta</th></tr></thead><tbody>
                @foreach (var f in futures) { <tr><td>@f.Especie</td><td>@Expiry(f.Vencimiento)</td><td>@Price(f.Ultimo)</td><td class="@(f.Variacion?.StartsWith("-") == true ? "negative" : "positive")">@Percentage(f.Variacion)</td><td>@Price(f.PrecioCompra)</td><td>@Price(f.PrecioVenta)</td></tr> }
            </tbody></table></div>
        }
        <p class="disclaimer">Los precios de futuros reflejan contratos de mercado, no predicciones garantizadas. Las fechas y horas informadas corresponden a la fuente.</p>
    </section>
    <section class="panel">
        <div class="eyebrow">ESCENARIOS / EXPERIMENTAL</div><div class="section-heading compact"><h2>Una referencia estadística.</h2></div>
        <p class="disclaimer">Extrapolación del precio de compra respecto de sus promedios de 7 y 30 días. No utiliza inteligencia artificial ni expresa probabilidades de acierto.</p>
        @if (projections.Count == 0) { <div class="empty-state">Los escenarios se habilitan cuando hay al menos cinco días distintos de datos.</div> }
        else {
            <div class="table-scroll"><table class="market-table"><thead><tr><th>Dólar</th><th>Escenario semanal</th><th>Escenario mensual</th><th>Metodología</th></tr></thead><tbody>
                @foreach (var p in projections) { <tr><td>@p.Nombre</td><td>@MarketFormat.Money(p.ValorSemana)</td><td>@MarketFormat.Money(p.ValorMes)</td><td>@p.Justificacion</td></tr> }
            </tbody></table></div>
        }
    </section>
    <p class="disclaimer">Información de referencia. Verificá valores y condiciones con tu entidad antes de operar. No constituye asesoramiento financiero.</p>
</div>
@code {
    private List<FuturoRavaRofex> futures = [];
    private List<ProyeccionDolar> projections = [];
    protected override async Task OnInitializedAsync() {
        futures = await Quotes.ObtenerUltimosFuturosRavaAsync();
        projections = await Quotes.ObtenerUltimaProyeccionAsync();
    }
    private static string Price(string? raw) => decimal.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out var value) ? MarketFormat.Money(value) : "—";
    private static string Percentage(string? raw) => decimal.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out var value) ? value.ToString("N2", MarketFormat.Culture) + " %" : "—";
    private static string Expiry(string raw) => DateTimeOffset.TryParse(raw, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var date) ? date.ToString("dd/MM/yyyy") : raw;
}
