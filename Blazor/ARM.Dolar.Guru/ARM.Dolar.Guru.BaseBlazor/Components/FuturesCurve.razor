@using ARM.Dolar.Guru.Services
@using ARM.Dolar.Guru.BaseBlazor.Models
@inject CotizacionesService Quotes
@if (values.Count > 1)
{
    <div class="chart-value">@MarketFormat.Money(values[0].Ultimo)<small>Contrato con vencimiento más próximo</small></div>
    <svg class="history-chart" viewBox="0 0 720 200" role="img" aria-label="Curva de precios de contratos de dólar futuro por vencimiento">
        <path d="M 0 30 H 720 M 0 90 H 720 M 0 150 H 720" stroke="#e4e9e9" stroke-dasharray="4 5" fill="none" />
        <polyline points="@Points" fill="none" stroke="#3a7563" stroke-width="3" stroke-linejoin="round" />
    </svg>
    <div class="chart-axis"><span>@values[0].FechaVencimiento.ToString("dd/MM/yyyy")</span><span>@values[^1].FechaVencimiento.ToString("dd/MM/yyyy")</span></div>
    <p class="disclaimer">Vencimientos en el eje horizontal; precios en pesos en el vertical. Rango: @MarketFormat.Money(values.Min(x => x.Ultimo)) — @MarketFormat.Money(values.Max(x => x.Ultimo)). Escala ajustada. Detalle en la tabla.</p>
}
@code {
    private List<(DateTime FechaVencimiento, decimal Ultimo)> values = [];
    protected override async Task OnInitializedAsync() =>
        values = (await Quotes.ObtenerHistoricoFuturosAsync()).Where(x => x.Ultimo > 0).ToList();
    private string Points {
        get {
            if (values.Count < 2) return "";
            var min = values.Min(x => x.Ultimo);
            var span = values.Max(x => x.Ultimo) - min;
            var days = Math.Max(1, (values[^1].FechaVencimiento - values[0].FechaVencimiento).TotalDays);
            return string.Join(" ", values.Select(x => FormattableString.Invariant(
                $"{(x.FechaVencimiento - values[0].FechaVencimiento).TotalDays / days * 720:0.##},{(span == 0 ? 100 : 175 - (x.Ultimo - min) / span * 150):0.##}")));
        }
    }
}
