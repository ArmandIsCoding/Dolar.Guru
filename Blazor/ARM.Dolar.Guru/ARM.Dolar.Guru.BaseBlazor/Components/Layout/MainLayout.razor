    <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Dólar Gurú, inicio"><span class="brand-symbol">g<span>↗</span></span><span>dólar<span class="brand-light">gurú</span><i></i></span></a>
        <nav aria-label="Navegación principal">
            <NavLink href="/" Match="NavLinkMatch.All">Panel general</NavLink>
            <a href="/#mercados">Mercados globales</a>
            <NavLink href="/proyecciones">Futuros &amp; histórico</NavLink>
